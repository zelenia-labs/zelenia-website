section.site-section.diagnostic-section#diagnostic(aria-labelledby="diagnostic-title")
  .container
    .section-header
      span.section-tag Interactive Assessment &amp; FAQ
      h2.section-title#diagnostic-title Diagnose your project scope in real time.
      p.section-subhead
        | Select your primary web challenge below to inspect our direct deliverables, timeline estimates, division of labor, and process answers.

    .diagnostic-console#diagnostic-tool
      //- Category Tabs (Control 1)
      .diagnostic-nav(role="tablist" aria-label="Project Scope Categories")
        for cat, index in diagnosticData.categories
          button.diagnostic-tab(
            type="button"
            role="tab"
            id=`tab-${cat.id}`
            aria-selected=(index === 0 ? "true" : "false")
            aria-controls="diagnostic-panel"
            data-category=cat.id
            tabindex=(index === 0 ? "0" : "-1")
          )
            span.diagnostic-tab__label #{cat.label}

      //- Pace Selector (Control 2)
      .diagnostic-control-bar
        .pace-control-wrap
          span.control-label PACE MODEL:
          .diagnostic-pace-toggle(role="group" aria-label="Execution Pace Selection")
            for pace, index in diagnosticData.paces
              button.diagnostic-pace-btn(
                type="button"
                id=`pace-${pace.id}`
                aria-pressed=(index === 0 ? "true" : "false")
                data-pace=pace.id
              )
                span.diagnostic-pace-btn__text #{pace.label}

      //- Reactive Output Dashboard
      .diagnostic-dashboard#diagnostic-panel(
        role="tabpanel"
        aria-labelledby="tab-vitals"
        tabindex="0"
      )
        //- Telemetry Stat Row
        .diagnostic-telemetry
          .telemetry-cell.telemetry-cell--turnaround
            span.telemetry-label [ ESTIMATED TURNAROUND ]
            .telemetry-value-row
              span.telemetry-value#stat-turnaround 2 to 3 Weeks
            span.telemetry-sub#stat-pace-label Phased Sprint Cadence

          .telemetry-cell.telemetry-cell--division
            .telemetry-division-header
              span.telemetry-label [ DIVISION OF LABOR ]
              span.telemetry-ratio#stat-division-label 75% Engineering / 25% Design
            .division-meter(aria-label="Division of labor visual bar")
              .division-meter__eng#bar-engineering(
                style="inline-size: 75%;"
                title="Engineering: Architecture & Code"
              )
                span.meter-tag Eng 75%
              .division-meter__design#bar-design(
                style="inline-size: 25%;"
                title="Design: UI/UX & Visual Systems"
              )
                span.meter-tag Des 25%
            .division-meter__legend
              span.meter-legend-item.meter-legend-item--eng Architecture &amp; Code
              span.meter-legend-item.meter-legend-item--design UI/UX &amp; Visual Systems

        //- Split Grid: Production Deliverables & Benchmarks
        .diagnostic-grid
          //- Deliverables Card
          .diagnostic-panel.diagnostic-panel--deliverables
            .panel-header
              span.panel-code [ DELIVERABLES ]
              h3.panel-title Direct Production Deliverables
            ul.deliverables-list#deliverables-list
              for item in diagnosticData.categories[0].deliverables.standard
                li.deliverables-list__item
                  span.deliverables-bullet(aria-hidden="true") —
                  span.deliverables-text #{item}

          //- Benchmarks Card
          .diagnostic-panel.diagnostic-panel--benchmarks
            .panel-header
              span.panel-code [ TELEMETRY TARGETS ]
              h3.panel-title Target Benchmark Outputs
            .benchmarks-grid#benchmarks-grid
              for bench in diagnosticData.categories[0].benchmarks
                .benchmark-tile
                  span.benchmark-tile__metric #{bench.metric}
                  span.benchmark-tile__label #{bench.label}

        //- Contextual Operational FAQ
        .diagnostic-panel.diagnostic-panel--faq
          .panel-header
            span.panel-code [ OPERATIONAL DIRECTIVES ]
            h3.panel-title Contextual Operational FAQs
          .accordion#diagnostic-faq-accordion
            for faq, fIndex in diagnosticData.categories[0].faqs
              .accordion-item
                button.accordion-trigger(
                  type="button"
                  id=`faq-trigger-0-${fIndex}`
                  aria-expanded=(fIndex === 0 ? "true" : "false")
                  aria-controls=`faq-panel-0-${fIndex}`
                )
                  span.accordion-trigger__text #{faq.q}
                  span.accordion-trigger__icon(aria-hidden="true") #{fIndex === 0 ? '−' : '+'}
                .accordion-content(
                  id=`faq-panel-0-${fIndex}`
                  role="region"
                  aria-labelledby=`faq-trigger-0-${fIndex}`
                  hidden=(fIndex === 0 ? false : true)
                )
                  .accordion-content__inner
                    p #{faq.a}

    //- Serialized Data for JavaScript Reactivity
    script#diagnostic-json-data(type="application/json")
      != JSON.stringify(diagnosticData)
