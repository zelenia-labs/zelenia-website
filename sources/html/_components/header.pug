header.site-header#site-header
  .header-inner
    a.site-logo(href="/" aria-label="Zelenia Home")
      span.logo-text Zelenia
      span.logo-slash(aria-hidden="true") /
      span.logo-subtext Studio

    button.nav-toggle#nav-toggle(
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
      aria-label="Toggle navigation menu"
    )
      span.hamburger-bar
      span.hamburger-bar
      span.hamburger-bar

    nav.site-nav#site-navigation(aria-label="Main Navigation")
      for item in site.nav
        a.nav-link(href=item.href data-nav-link=item.href) #{item.label}
      a.btn.btn--primary.btn--header(href="/#contact")
        span Book a Review
        span.arrow-indicator(aria-hidden="true") ↗
