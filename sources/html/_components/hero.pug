section.hero-section#hero(aria-label="Studio Introduction")
  .container.hero-container
    .hero-meta-badge
      span.hero-meta-badge__dot
      span.hero-meta-badge__code [ STUDIO // RESEARCH &amp; DIRECT EXECUTION ]
      span.hero-meta-badge__pill 2026

    h1.hero-title
      | Elite frontend engineering meets 
      span.font-serif high-precision product design.

    p.hero-subheadline
      | Zelenia is a dedicated two-partner studio pairing a Fortune 100 Principal Engineer with an industry-tested Lead Product Designer. We repair critical web vitals, rebuild complex digital interfaces, and deliver production-ready software without the agency overhead.

    //- Interactive Live Site Audit Input Bar
    .hero-audit-form#hero-audit-form(role="search" aria-label="Live Site Performance Audit")
      .hero-audit-bar
        .input-icon(aria-hidden="true")
          svg(width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            circle(cx="12" cy="12" r="10")
            line(x1="2" y1="12" x2="22" y2="12")
            path(d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z")
        input.hero-audit-input#hero-audit-url(
          type="url"
          placeholder="https://yourcompany.com"
          aria-label="Enter your website URL for PageSpeed analysis"
          spellcheck="false"
          autocomplete="url"
        )
        button.btn.btn--primary.btn--hero-audit#hero-audit-btn(type="button")
          span.btn-text Analyze Site
          span.arrow-indicator(aria-hidden="true") →
          span.btn-spinner(aria-hidden="true")

      p.hero-alternative-prompt
        | Don't have a live website yet? No problem &mdash; 
        a.hero-alt-link(href="#contact") talk to the partners directly &rarr;

    //- Live Audit Console Widget (Open, Box-Free Layout)
    .hero-audit-widget#hero-audit-widget(hidden aria-live="polite")
      //- Loading & Scanner State
      .audit-scanner#audit-scanner(hidden)
        .scanner-spinner(aria-hidden="true")
          .scanner-ring
          .scanner-pulse
        .scanner-status
          span.scanner-title Scanning Architecture &amp; Web Vitals
          span.scanner-log#scanner-log Connecting to Google PageSpeed Insights API...

      //- Result Dashboard (Open & Box-Free)
      .audit-results#audit-results(hidden)
        .audit-results__header
          .audit-target
            span.audit-target__label URL ANALYZED:
            span.audit-target__url#audit-display-url https://example.com
          .audit-badge-wrap
            span.audit-badge#audit-source-badge [ GOOGLE PAGESPEED LIVE API ]

        //- Simulation Notice (Only shown if live API was unreachable)
        .audit-simulation-alert#audit-simulation-alert(hidden)
          span.alert-icon(aria-hidden="true") ℹ
          .alert-text
            strong Notice: 
            span#audit-fallback-reason Origin unreachable.
            |  Displaying synthetic architectural simulation based on standard modern frontend baselines.

        //- Core 4-Gauge Metric Row (Floating, Box-Free)
        .audit-gauges-grid
          .gauge-card
            .gauge-circle(data-score="perf")
              svg.gauge-svg(viewBox="0 0 36 36")
                path.gauge-bg(d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831")
                path.gauge-val#gauge-perf-val(
                  stroke-dasharray="0, 100"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                )
              span.gauge-number#gauge-perf-num --
            span.gauge-label Performance

          .gauge-card
            .gauge-circle(data-score="a11y")
              svg.gauge-svg(viewBox="0 0 36 36")
                path.gauge-bg(d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831")
                path.gauge-val#gauge-a11y-val(
                  stroke-dasharray="0, 100"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                )
              span.gauge-number#gauge-a11y-num --
            span.gauge-label Accessibility

          .gauge-card
            .gauge-circle(data-score="seo")
              svg.gauge-svg(viewBox="0 0 36 36")
                path.gauge-bg(d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831")
                path.gauge-val#gauge-seo-val(
                  stroke-dasharray="0, 100"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                )
              span.gauge-number#gauge-seo-num --
            span.gauge-label Technical SEO

          .gauge-card
            .gauge-circle(data-score="agentic")
              svg.gauge-svg(viewBox="0 0 36 36")
                path.gauge-bg(d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831")
                path.gauge-val#gauge-agentic-val(
                  stroke-dasharray="0, 100"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                )
              span.gauge-number#gauge-agentic-num --
            span.gauge-label Agentic Readiness

        //- Core Web Vitals Breakdown Bar (Open Typographic Row)
        .audit-vitals-row
          .vital-pill
            span.vital-name LCP (Largest Contentful Paint)
            span.vital-val#vital-lcp-val -- s
            span.vital-badge#vital-lcp-badge Status

          .vital-pill
            span.vital-name INP (Interaction to Next Paint)
            span.vital-val#vital-inp-val -- ms
            span.vital-badge#vital-inp-badge Status

          .vital-pill
            span.vital-name CLS (Cumulative Layout Shift)
            span.vital-val#vital-cls-val --
            span.vital-badge#vital-cls-badge Status

        //- Remediation Callout
        .audit-remediation-bar
          .remediation-text
            h4.remediation-title Ready to eliminate technical bottlenecks?
            p.remediation-sub Zelenia partners engineer direct solutions with zero junior delegation.
          button.btn.btn--primary.btn--remediate#audit-remediate-btn(type="button")
            span Remediate with Partners
            span.arrow-indicator(aria-hidden="true") &rarr;

    //- Box-Free Open Verification Proof Row
    .hero-proof-row(aria-label="Studio Verification Metrics")
      .proof-item
        span.proof-item__metric 20+
        span.proof-item__label Years Enterprise Architecture
        span.proof-item__sub Fortune 100 Principal Engineer

      .proof-separator(aria-hidden="true")

      .proof-item
        span.proof-item__metric 10+
        span.proof-item__label Years Unicorn Product Design
        span.proof-item__sub Seed to Series E Leadership

      .proof-separator(aria-hidden="true")

      .proof-item
        span.proof-item__metric GDE
        span.proof-item__label Google Developer Expert
        span.proof-item__sub Web Technologies &amp; Architecture
