section.site-section.capabilities-section#capabilities(aria-labelledby="capabilities-title")
  .container
    .capabilities-breather
      .section-header
        span.section-tag Capabilities
        h2.section-title#capabilities-title Engineered for speed, built for conversion.
        p.section-subhead
          | High-precision technical interventions and design modernization. We eliminate runtime friction, guarantee sub-second rendering, and deliver design-to-code parity.

      .capabilities-pillars-row
        article.capability-pillar
          span.capability-pillar__num 01
          h3.capability-pillar__name Core Web Vitals &amp; Runtime Performance
          p.capability-pillar__desc Sub-1.8s LCP, zero layout shift (CLS), and interaction-to-next-paint (INP) refactoring.

        article.capability-pillar
          span.capability-pillar__num 02
          h3.capability-pillar__name Responsive Architecture &amp; Device Parity
          p.capability-pillar__desc Modern CSS Grid, fluid container queries, and flawless multi-display parity.

        article.capability-pillar
          span.capability-pillar__num 03
          h3.capability-pillar__name Semantic HTML, WCAG 2.2 AA &amp; Technical SEO
          p.capability-pillar__desc Clean DOM structures, screen reader certification, and search crawl efficiency.

        article.capability-pillar
          span.capability-pillar__num 04
          h3.capability-pillar__name Tokenized Design Systems &amp; Modernization
          p.capability-pillar__desc Figma-to-code token parity, accessible modular UI libraries, and GPU micro-motion.

      .capabilities-action
        a.btn.btn--primary.btn--capabilities-dossier(
          href="/capabilities.html"
          aria-label="Explore Full Technical Capabilities Dossier"
        )
          span Explore Full Capabilities Dossier
          span.arrow-indicator(aria-hidden="true") →
