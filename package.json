{
  "name": "zelenia-website",
  "version": "1.0.1",
  "description": "Zelenia Studio SPA",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "vite",
    "build": "vite build && cp -r dist/analog/public/* dist/",
    "watch": "vite build --watch",
    "test": "vitest",
    "preview": "vite preview --outDir dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@analogjs/content": "^2.9.7",
    "@analogjs/router": "^2.9.7",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "front-matter": "^4.0.2",
    "marked": "^15.0.12",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "marked-mangle": "^1.1.14",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.2",
    "three": "^0.186.1",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.9.7",
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@analogjs/vitest-angular": "^2.9.7",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
    "angular-eslint": "^22.8.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^22.1.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
}
