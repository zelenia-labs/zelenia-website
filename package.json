{
  "name": "zelenia-website",
  "version": "1.0.1",
  "description": "Zelenia Boutique Studio SPA",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "vite",
    "build": "vite build && cp -r dist/analog/public/* dist/",
    "watch": "vite build --watch",
    "test": "vitest",
    "preview": "node dist/analog/server/index.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@analogjs/content": "^2.7.1",
    "@analogjs/router": "^2.7.1",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "front-matter": "^4.0.2",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.7.1",
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@analogjs/vitest-angular": "^2.7.1",
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.1",
    "angular-eslint": "^22.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^22.0.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
}
